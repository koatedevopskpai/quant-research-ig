# =============================================================================
# IG Market Data Project — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =============================================================================

# --- IG API Credentials (Required) ---
# Obtain these from your IG Group account:
#   https://labs.ig.com
IG_API_KEY=your_api_key_here
IG_USERNAME=your_username_here
IG_PASSWORD=your_password_here
IG_ACCOUNT_TYPE=DEMO

# --- PostgreSQL Connection (Optional, Phase 1+) ---
# Used by the ingestion pipeline for persistent storage.
# Defaults are local dev values — override for production.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ig_market_data
PGUSER=postgres
PGPASSWORD=postgres
